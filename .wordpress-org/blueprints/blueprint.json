{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/hello-world/",
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"blogname": "Open Graph Demo",
				"blogdescription": "Adds Open Graph metadata to your pages"
			}
		},
		{
			"step": "installPlugin",
			"pluginZipFile": {
				"resource": "wordpress.org/plugins",
				"slug": "opengraph"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		}
	]
}
